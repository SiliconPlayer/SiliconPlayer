# Maintainer: Flopster101 <nahuelgomez329@gmail.com>
pkgname=siliconplayer
pkgver=0.1.0
pkgrel=1
pkgdesc="Modern chiptune and module music player"
arch=('x86_64')
url="https://github.com/SiliconPlayer/SiliconPlayer"
license=('GPL-3.0-or-later')
# System JRE on purpose: the release distributable's bundled runtime is dropped.
depends=('java-runtime>=17' 'alsa-lib' 'libpulse' 'libgl' 'libx11' 'dbus' 'hicolor-icon-theme')
makedepends=('cmake' 'git' 'imagemagick' 'jdk-openjdk')
# Building also configures the Android module, so an Android SDK with
# cmdline-tools + platform 34 is required (ANDROID_HOME or ~/Android/Sdk).
source=("$pkgname::git+$url.git#branch=kmp-new")
sha256sums=('SKIP')

build() {
    cd "$pkgname"
    ./gradlew :desktop:createReleaseDistributable --no-daemon
    convert desktop/src/main/resources/app_icon.webp -resize 256x256 siliconplayer.png
}

package() {
    cd "$pkgname"
    local appdir="desktop/build/compose/binaries/main-release/app/SiliconPlayer"
    install -dm755 "$pkgdir/usr/lib/siliconplayer/app"
    cp -a "$appdir/lib/app/." "$pkgdir/usr/lib/siliconplayer/app/"
    rm -rf "$pkgdir/usr/lib/siliconplayer/app/runtime"
    install -Dm755 packaging/arch/siliconplayer.sh "$pkgdir/usr/bin/siliconplayer"
    install -Dm644 packaging/arch/siliconplayer.desktop "$pkgdir/usr/share/applications/siliconplayer.desktop"
    install -Dm644 siliconplayer.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/siliconplayer.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/siliconplayer/LICENSE"
    install -Dm644 external/ffmpeg/COPYING.LGPLv2.1 "$pkgdir/usr/share/licenses/siliconplayer/COPYING.FFmpeg"
}
