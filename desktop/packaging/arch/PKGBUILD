# Maintainer: Flopster101 <nahuelgomez329@gmail.com>
pkgname=siliconplayer
pkgver=0.1.0
pkgrel=1
pkgdesc="Modern chiptune and module music player"
arch=('x86_64')
url="https://github.com/SiliconPlayer/SiliconPlayer"
license=('GPL-3.0-or-later')
# System JRE on purpose: the release distributable's bundled runtime is dropped.
depends=('java-runtime>=17' 'alsa-lib' 'libpulse' 'libgl' 'libx11' 'dbus' 'hicolor-icon-theme')
makedepends=('git' 'cmake' 'ninja' 'pkgconf' 'perl' 'python' 'nasm' 'xa'
             'jdk17-openjdk' 'alsa-lib' 'libpulse' 'libx11' 'libgl' 'vulkan-headers' 'zlib')
source=("$pkgname::git+$url.git#branch=master")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname"
    git submodule update --init --recursive
}

build() {
    cd "$pkgname"
    export JAVA_HOME=/usr/lib/jvm/java-17-openjdk
    BUILD_FFMPEG_SOURCE=1 ./external/build_deps_desktop.sh x86_64 all
    # Configure-on-demand keeps the Android module unconfigured,
    # so no Android SDK is needed for a desktop-only build.
    ./gradlew :desktop:createReleaseDistributable --no-daemon -Dorg.gradle.configureondemand=true
}

package() {
    cd "$pkgname"
    local appdir="desktop/build/compose/binaries/main-release/app/SiliconPlayer"
    install -dm755 "$pkgdir/usr/lib/siliconplayer/app"
    cp -a "$appdir/lib/app/." "$pkgdir/usr/lib/siliconplayer/app/"
    install -Dm755 desktop/packaging/arch/siliconplayer.sh "$pkgdir/usr/bin/siliconplayer"
    install -Dm644 desktop/packaging/arch/siliconplayer.desktop "$pkgdir/usr/share/applications/siliconplayer.desktop"
    install -Dm644 desktop/packaging/SiliconPlayer.png "$pkgdir/usr/share/icons/hicolor/192x192/apps/siliconplayer.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/siliconplayer/LICENSE"
    for text in desktop/build/generated/about/main/texts/*; do
        install -Dm644 "$text" "$pkgdir/usr/share/licenses/siliconplayer/$(basename "$text")"
    done
}
